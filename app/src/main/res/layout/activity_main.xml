<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextureView
        android:id="@+id/preview_texture"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Focus Indicator -->
    <ImageView
        android:id="@+id/focus_indicator"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/focus_circle"
        android:visibility="gone" />

    <!-- AE/AF Lock Button (appears with focus indicator) -->
    <ImageView
        android:id="@+id/ae_af_lock_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="#AA000000"
        android:padding="6dp"
        android:src="@drawable/ic_lock_open"
        android:scaleType="centerInside"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- EV Slider (vertical, appears near focus indicator in auto exposure mode) -->
    <FrameLayout
        android:id="@+id/ev_slider_container"
        android:layout_width="48dp"
        android:layout_height="140dp"
        android:visibility="gone">

        <!-- Thin vertical line -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="#44FFFFFF" />

        <!-- Sun thumb only, track is invisible -->
        <SeekBar
            android:id="@+id/ev_seekbar_vertical"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:min="0"
            android:max="100"
            android:progress="50"
            android:rotation="-90"
            android:thumb="@drawable/ic_sun"
            android:progressDrawable="@android:color/transparent"
            android:splitTrack="false"
            android:padding="16dp" />
    </FrameLayout>

    <!-- Warning Toast Container -->
    <FrameLayout
        android:id="@+id/warningContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="48dp"
        android:visibility="gone">

<TextView
            android:id="@+id/tvWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#CC000000"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:text="This lens does not support tap-to-focus" />
        </FrameLayout>

        <TextView
            android:id="@+id/dev_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:background="#AA000000"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="Development Mode: Formed stream. Colors will be incorrect until RAW_SENSOR is available."
        android:textColor="#FFFFAA00"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Warning Toast Container -->
    <TextView
        android:id="@+id/disconnect_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:background="#AA000000"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="Camera disconnected by another app."
        android:textColor="#FFFF6666"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- WB Popup -->
    <include layout="@layout/wb_popup" />

    <!-- Top Controls + Thermal share top edge via FrameLayout -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Top icons: flash, wb, settings, camera switch -->
        <LinearLayout
            android:id="@+id/top_controls_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/flash_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#66000000"
                android:padding="8dp"
                android:src="@drawable/ic_flash_off"
                android:scaleType="centerInside"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/wb_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="#66000000"
                android:gravity="center"
                android:text="WB"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/settings_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="#66000000"
                android:padding="8dp"
                android:src="@drawable/ic_settings_gear"
                android:scaleType="centerInside"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/front_rear_toggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="#66000000"
                android:padding="8dp"
                android:src="@drawable/ic_camera_switch"
                android:scaleType="centerInside"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Thermal Indicator: top right, same top edge as icons -->
        <TextView
            android:id="@+id/thermal_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginEnd="8dp"
            android:background="#66000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text=""
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom Controls — compact, no overlap -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- Zoom Row (only visible when >1 lens) -->
        <LinearLayout
            android:id="@+id/zoom_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/zoom_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.0x"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:minWidth="40dp"
                android:gravity="end"
                android:visibility="gone" />

            <SeekBar
                android:id="@+id/zoom_slider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:min="0"
                android:max="400"
                android:progress="0"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Controls + Shutter share bottom edge via FrameLayout -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Controls row: thumbnail | AM | ISO | shutter label | lens buttons | cooldown -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:id="@+id/thumbnail_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/ic_photo_placeholder"
                    android:scaleType="centerCrop"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/am_toggle_button"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:background="#88333333"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="A"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/iso_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:background="#CC000000"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="ISO"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/shutter_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:background="#CC000000"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="1/30"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/lens_selector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />

                <TextView
                    android:id="@+id/cooldown_text"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text=""
                    android:textColor="#FFFFAA00"
                    android:textSize="14sp"
                    android:visibility="gone"
                    android:background="#66000000" />
            </LinearLayout>

            <!-- Shutter button: centered horizontally, baseline aligned with controls row -->
            <ImageView
                android:id="@+id/shutter_button"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal|bottom"
                android:src="@drawable/ic_shutter"
                android:scaleType="centerInside"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>

        <TextView
            android:id="@+id/shutter_state_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="2dp"
            android:text=""
            android:textColor="#88FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- ISO Popup — thin vertical line + dot, positioned dynamically above label -->
    <FrameLayout
        android:id="@+id/iso_popup"
        android:layout_width="48dp"
        android:layout_height="140dp"
        android:visibility="gone">

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="#44FFFFFF" />

        <SeekBar
            android:id="@+id/iso_seekbar"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:min="0"
            android:max="100"
            android:progress="50"
            android:rotation="-90"
            android:thumb="@drawable/seekbar_circle_thumb"
            android:progressDrawable="@android:color/transparent"
            android:splitTrack="false"
            android:padding="16dp" />
    </FrameLayout>

    <!-- Shutter Popup — thin vertical line + dot, positioned dynamically above label -->
    <FrameLayout
        android:id="@+id/shutter_popup"
        android:layout_width="48dp"
        android:layout_height="140dp"
        android:visibility="gone">

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="#44FFFFFF" />

        <SeekBar
            android:id="@+id/shutter_seekbar"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:min="0"
            android:max="100"
            android:progress="50"
            android:rotation="-90"
            android:thumb="@drawable/seekbar_circle_thumb"
            android:progressDrawable="@android:color/transparent"
            android:splitTrack="false"
            android:padding="16dp" />
    </FrameLayout>

    <!-- EV Popup (appears near focus indicator) -->
    <LinearLayout
        android:id="@+id/ev_popup"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="52dp"
        android:layout_marginBottom="130dp"
        android:background="#DD222222"
        android:padding="8dp"
        android:visibility="gone"
        android:orientation="vertical">
        <SeekBar android:id="@+id/ev_seekbar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:min="0" android:max="100" android:progress="50" />
    </LinearLayout>

    <!-- Settings Panel (slides from right) -->
    <ScrollView
        android:id="@+id/settings_panel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#CC111111"
        android:padding="12dp"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Preset Controls -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preset"
                android:textColor="#FFAAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <Spinner
                    android:id="@+id/preset_spinner"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="#444444"
                    android:popupBackground="#333333" />

                <TextView
                    android:id="@+id/preset_add_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="#444444"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/preset_save_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="#444444"
                    android:gravity="center"
                    android:text="Save"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/preset_delete_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="#444444"
                    android:gravity="center"
                    android:text="Del"
                    android:textColor="#FFFF6666"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/preset_rename_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="#444444"
                    android:gravity="center"
                    android:text="Rename"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/preset_reset_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="#444444"
                    android:gravity="center"
                    android:text="Reset"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginBottom="8dp" />

            <!-- Curve Parameters -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Curve" android:textColor="#FFAAAAAA" android:textSize="11sp" android:layout_marginBottom="4dp" />

            <TextView android:id="@+id/contrast_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contrast  2.4" android:textColor="#FFFFFFFF" android:textSize="11sp" />
            <SeekBar android:id="@+id/contrast_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="26" android:progress="10" android:layout_marginBottom="4dp" />

            <TextView android:id="@+id/toe_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Toe  1.5" android:textColor="#FFFFFFFF" android:textSize="11sp" />
            <SeekBar android:id="@+id/toe_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="93" android:progress="8" android:layout_marginBottom="4dp" />

            <TextView android:id="@+id/shoulder_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Shoulder  1.5" android:textColor="#FFFFFFFF" android:textSize="11sp" />
            <SeekBar android:id="@+id/shoulder_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="93" android:progress="8" android:layout_marginBottom="8dp" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginBottom="8dp" />

            <!-- Inset Primaries -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Inset Primaries" android:textColor="#FFAAAAAA" android:textSize="11sp" />
                <CheckBox android:id="@+id/use_pre_for_post_cb" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Use Pre for Post" android:textColor="#FFFFFFFF" android:textSize="10sp" android:checked="true" />
            </LinearLayout>

            <TextView android:id="@+id/inset_rot_r_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RGB Rot R  0.037" android:textColor="#FFFFFFFF" android:textSize="11sp" />
            <SeekBar android:id="@+id/inset_rot_r_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="524" android:progress="268" android:layout_marginBottom="2dp" />

            <TextView android:id="@+id/inset_rot_g_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RGB Rot G  -0.021" android:textColor="#FFFFFFFF" android:textSize="11sp" />
            <SeekBar android:id="@+id/inset_rot_g_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="524" android:progress="253" android:layout_marginBottom="2dp" />

            <TextView android:id="@+id/inset_rot_b_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RGB Rot B  -0.053" android:textColor="#FFFFFFFF" android:textSize="11sp" />
            <SeekBar android:id="@+id/inset_rot_b_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="524" android:progress="236" android:layout_marginBottom="4dp" />

            <TextView android:id="@+id/inset_pur_r_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Purity R  33.0" android:textColor="#FFFFFFFF" android:textSize="11sp" />
            <SeekBar android:id="@+id/inset_pur_r_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="60" android:progress="33" android:layout_marginBottom="2dp" />

            <TextView android:id="@+id/inset_pur_g_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Purity G  28.1" android:textColor="#FFFFFFFF" android:textSize="11sp" />
            <SeekBar android:id="@+id/inset_pur_g_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="60" android:progress="28" android:layout_marginBottom="2dp" />

            <TextView android:id="@+id/inset_pur_b_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Purity B  12.5" android:textColor="#FFFFFFFF" android:textSize="11sp" />
            <SeekBar android:id="@+id/inset_pur_b_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="60" android:progress="12" android:layout_marginBottom="8dp" />

            <!-- Outset Primaries (hidden when Use Pre for Post is on) -->
            <LinearLayout android:id="@+id/outset_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginBottom="8dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Outset Primaries" android:textColor="#FFAAAAAA" android:textSize="11sp" android:layout_marginBottom="4dp" />

                <TextView android:id="@+id/outset_rot_r_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rev Rot R  0.0" android:textColor="#FFFFFFFF" android:textSize="11sp" />
                <SeekBar android:id="@+id/outset_rot_r_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="524" android:progress="262" android:layout_marginBottom="2dp" />

                <TextView android:id="@+id/outset_rot_g_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rev Rot G  0.0" android:textColor="#FFFFFFFF" android:textSize="11sp" />
                <SeekBar android:id="@+id/outset_rot_g_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="524" android:progress="262" android:layout_marginBottom="2dp" />

                <TextView android:id="@+id/outset_rot_b_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rev Rot B  0.0" android:textColor="#FFFFFFFF" android:textSize="11sp" />
                <SeekBar android:id="@+id/outset_rot_b_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="524" android:progress="262" android:layout_marginBottom="4dp" />

                <TextView android:id="@+id/outset_pur_r_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Restore R  32.3" android:textColor="#FFFFFFFF" android:textSize="11sp" />
                <SeekBar android:id="@+id/outset_pur_r_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="60" android:progress="32" android:layout_marginBottom="2dp" />

                <TextView android:id="@+id/outset_pur_g_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Restore G  28.3" android:textColor="#FFFFFFFF" android:textSize="11sp" />
                <SeekBar android:id="@+id/outset_pur_g_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="60" android:progress="28" android:layout_marginBottom="2dp" />

                <TextView android:id="@+id/outset_pur_b_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Restore B  3.7" android:textColor="#FFFFFFFF" android:textSize="11sp" />
                <SeekBar android:id="@+id/outset_pur_b_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="60" android:progress="4" android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/copy_inset_to_outset_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="#444444"
                    android:gravity="center"
                    android:text="Copy Inset to Outset"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginBottom="8dp" />

            <!-- Global Tinting -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tinting" android:textColor="#FFAAAAAA" android:textSize="11sp" android:layout_marginBottom="4dp" />

            <TextView android:id="@+id/tinting_scale_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Scale  0.00" android:textColor="#FFFFFFFF" android:textSize="11sp" />
            <SeekBar android:id="@+id/tinting_scale_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="400" android:progress="200" android:layout_marginBottom="4dp" />

            <TextView android:id="@+id/tinting_hue_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hue  0.00" android:textColor="#FFFFFFFF" android:textSize="11sp" />
            <SeekBar android:id="@+id/tinting_hue_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="628" android:progress="314" android:layout_marginBottom="8dp" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginBottom="8dp" />

            <!-- NR -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Noise Reduction" android:textColor="#FFAAAAAA" android:textSize="11sp" android:layout_marginBottom="4dp" />

            <TextView android:id="@+id/nr_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NR Strength  0.0" android:textColor="#FFFFFFFF" android:textSize="11sp" />
            <SeekBar android:id="@+id/nr_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="100" android:progress="0" android:layout_marginBottom="8dp" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginBottom="8dp" />

            <!-- White Balance -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="White Balance" android:textColor="#FFAAAAAA" android:textSize="11sp" android:layout_marginBottom="4dp" />

            <TextView android:id="@+id/kelvin_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Kelvin  5500K" android:textColor="#FFFFFFFF" android:textSize="11sp" />
            <SeekBar android:id="@+id/kelvin_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="80" android:progress="35" android:layout_marginBottom="4dp" />

            <TextView android:id="@+id/tint_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tint  0" android:textColor="#FFFFFFFF" android:textSize="11sp" />
            <SeekBar android:id="@+id/tint_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="0" android:max="200" android:progress="100" android:layout_marginBottom="8dp" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginBottom="8dp" />

            <!-- Photo Output -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Photo Output" android:textColor="#FFAAAAAA" android:textSize="11sp" android:layout_marginBottom="4dp" />

            <TextView android:id="@+id/jpeg_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="JPEG Quality  85" android:textColor="#FFFFFFFF" android:textSize="11sp" />
            <SeekBar android:id="@+id/jpeg_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="1" android:max="100" android:progress="85" android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/resolution_spinner"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="#444444"
                android:popupBackground="#333333"
                android:layout_marginBottom="16dp" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginBottom="8dp" />

            <!-- Developer Settings (debug builds only) -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Developer Settings" android:textColor="#FFAAAAAA" android:textSize="11sp" android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/developer_raw_toggle_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Use RAW_SENSOR Stream"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />

                <Switch
                    android:id="@+id/developer_raw_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/developer_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YUV fallback mode"
                android:textColor="#FFFFAA00"
                android:textSize="10sp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/save_debug_log_btn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="#444444"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Save Debug Log to Downloads"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </ScrollView>

    <!-- Finishing Capture Overlay -->
    <TextView
        android:id="@+id/finishing_capture_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:gravity="center"
        android:text="Finishing capture..."
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Lens Switch Overlay -->
    <TextView
        android:id="@+id/lens_switch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:gravity="center"
        android:text=""
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

</FrameLayout>
